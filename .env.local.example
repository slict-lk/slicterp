# ========================================
# Local AI Engine Configuration
# ========================================

# Base URL for Ollama server
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# AI Model to use
# Options: llama2, mistral, neural-chat, orca2, phi, dolphin
# Default: llama2
OLLAMA_MODEL=llama2

# Temperature (0.0 = deterministic, 1.0 = creative)
# Range: 0.0 - 1.0
# Default: 0.7
OLLAMA_TEMPERATURE=0.7

# Maximum tokens per response
# Default: 2000
OLLAMA_MAX_TOKENS=2000

# Request timeout in milliseconds
# Default: 60000 (60 seconds)
OLLAMA_TIMEOUT=60000

# Enable fallback/offline mode
# When true: uses mock responses if Ollama is unavailable
# Default: false
OLLAMA_FALLBACK_MODE=false

# ========================================
# Environment-Specific Settings
# ========================================

# For Development
# - Verbose logging: true
# - Longer timeout: allows time to think
# - Higher temperature: more creative responses
# OLLAMA_MODEL=llama2
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_MAX_TOKENS=2000
# OLLAMA_TIMEOUT=60000

# For Production (Fast Responses)
# - Smaller model: faster responses
# - Lower timeout: prevent hanging
# - Lower temperature: more consistent
# OLLAMA_MODEL=mistral
# OLLAMA_TEMPERATURE=0.5
# OLLAMA_MAX_TOKENS=1500
# OLLAMA_TIMEOUT=45000

# For Production (Better Accuracy)
# - Better reasoning model
# - More tokens: longer responses
# - Lower temperature: more consistent
# OLLAMA_MODEL=orca2
# OLLAMA_TEMPERATURE=0.3
# OLLAMA_MAX_TOKENS=3000
# OLLAMA_TIMEOUT=60000

# For Low Memory Systems
# - Smallest model: uses less RAM
# - Limited tokens: reduces memory usage
# OLLAMA_MODEL=phi
# OLLAMA_MAX_TOKENS=500
# OLLAMA_TIMEOUT=30000

# ========================================
# Model Specifications
# ========================================
# 
# llama2 (7B)
# - Size: ~4GB RAM
# - Speed: Medium
# - Quality: Good
# - Best for: General purpose
#
# mistral (7B)
# - Size: ~5GB RAM
# - Speed: Fast
# - Quality: Good
# - Best for: Speed + quality balance
#
# neural-chat (7B)
# - Size: ~4.7GB RAM
# - Speed: Medium
# - Quality: Good
# - Best for: Chat applications
#
# orca2 (7B)
# - Size: ~3.6GB RAM
# - Speed: Medium
# - Quality: Excellent
# - Best for: Complex reasoning
#
# phi (2.7B)
# - Size: ~1.6GB RAM
# - Speed: Very Fast
# - Quality: Fair
# - Best for: Low memory systems
#
# dolphin (7B)
# - Size: ~3.6GB RAM
# - Speed: Medium
# - Quality: Excellent
# - Best for: Following instructions
#
# ========================================

# Shared bearer secret for automated cron routes (set a long random value in real deployments)
CRON_SECRET=your_placeholder_cron_secret
