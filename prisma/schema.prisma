  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, archivedAt])
  @@index([projectId, sprintId])
  @@index([projectId, rank])
}

