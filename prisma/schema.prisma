  description    String?
  isActive       Boolean            @default(true)
  isDefault      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  stockLedgers   InvStockLedger[]
  stockMovements InvStockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InvStockLedger {
  id          String       @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  onHand      Decimal      @default(0)
  reserved    Decimal      @default(0)
  updatedAt   DateTime     @updatedAt
  product     InvProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   InvWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([tenantId])
}

model InvStockMovement {
  id              String        @id @default(cuid())
  tenantId        String
  productId       String
  warehouseId     String?
  type            String
  direction       Int
  quantity        Decimal
  unitCost        Decimal       @default(0)
  totalCost       Decimal       @default(0)
  sourceModule    String?
  sourceDocument  String?
  reference       String?
  notes           String?
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())
  glPostingStatus String?
  product         InvProduct    @relation(fields: [productId], references: [id])
  warehouse       InvWarehouse? @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, sourceModule])
  @@index([tenantId, date])
}

model InvSupplier {
  id             String             @id @default(cuid())
  tenantId       String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  currency       String             @default("LKR")
  paymentTerms   String?
  taxId          String?
  rating         Int?
  isActive       Boolean            @default(true)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  products       InvProduct[]
  purchaseOrders InvPurchaseOrder[]

  @@index([tenantId])
}

model InvPurchaseOrder {
  id              String                 @id @default(cuid())
  tenantId        String
  supplierId      String?
  poNumber        String
  status          String                 @default("DRAFT")
  currency        String                 @default("LKR")
  subtotal        Decimal                @default(0)
  taxAmount       Decimal                @default(0)
  total           Decimal                @default(0)
  notes           String?
  expectedAt      DateTime?
  confirmedAt     DateTime?
  receivedAt      DateTime?
  glPostingStatus String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  supplier        InvSupplier?           @relation(fields: [supplierId], references: [id])
  lines           InvPurchaseOrderLine[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model InvPurchaseOrderLine {
  id              String           @id @default(cuid())
  purchaseOrderId String
  productId       String
  description     String?
  quantity        Decimal
  unitCost        Decimal
  lineTotal       Decimal
  taxPct          Decimal          @default(0)
  receivedQty     Decimal          @default(0)
  product         InvProduct       @relation(fields: [productId], references: [id])
  purchaseOrder   InvPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([purchaseOrderId, productId])
}

