# Ollama Configuration for SLICT ERP
# Copy this to .env.local and adjust as needed

# Ollama API Server URL
# For local development: http://localhost:11434
# For Docker: http://ollama:11434
OLLAMA_API_URL=http://localhost:11434

# Default model to use for AI operations
# Available: llama2, mistral, neural-chat, dolphin-mixtral, orca-mini, vicuna, zephyr
OLLAMA_MODEL=llama2

# Optional: Use streaming responses (experimental)
# OLLAMA_STREAM=true

# Optional: Temperature for model responses (0.0 - 2.0)
# Higher = more creative, Lower = more focused
# OLLAMA_TEMPERATURE=0.7

# Optional: Max tokens for generation
# Limits response length to save resources
# OLLAMA_MAX_TOKENS=512

# Optional: Enable Ollama request logging
# OLLAMA_DEBUG=false
